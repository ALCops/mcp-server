<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>Latest</LangVersion>
        <Nullable>enable</Nullable>

        <!-- BC DevTools compile floor. Deliberately the lowest supported stable release: the server
             is compiled against the oldest SDK it must support and runs against whatever newer SDK
             the user has installed. CI overrides these to run its version matrix. -->
        <BcDevToolsVersion Condition="'$(BcDevToolsVersion)'==''">18.0.41.39415</BcDevToolsVersion>
        <BcToolsTfm Condition="'$(BcToolsTfm)'==''">net10.0</BcToolsTfm>

        <!-- 18.x ships its own ModelContextProtocol.Core (1.0.0) next to the DLLs we reference, so
             MSBuild's dependency walk reports a conflict with our 0.9.0-preview.2. It is noise: we
             never reference Microsoft.Dynamics.Nav.Deployment (the only consumer), and at runtime
             BcToolsLocator's resolver is a *fallback* hook, so our own copy always resolves first. -->
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

        <!-- Dotnet tool packaging -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>alcops-mcp</ToolCommandName>
        <PackageId>ALCops.Mcp</PackageId>
        <Title>ALCops MCP Server</Title>
        <Description>MCP server providing AL code analysis tools for AI assistants.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://alcops.dev</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ALCops.Mcp.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" Version="0.9.0-preview.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
        <PackageReference Include="System.Composition.AttributedModel" Version="8.0.0" />
    </ItemGroup>

    <!-- BC DevTools: restored into the global packages folder but never referenced as a package.
         The package is DotnetTool+Template only (no `Dependency` package type, no lib/ folder), so
         NuGet rejects a PackageReference to it; PackageDownload sidesteps that and gives us a
         stable path to hint at. Exact-version bracket syntax is required by PackageDownload. -->
    <ItemGroup>
        <PackageDownload Include="Microsoft.Dynamics.BusinessCentral.Development.Tools" Version="[$(BcDevToolsVersion)]" />
    </ItemGroup>

    <!-- Compile-time only. Private=false keeps Microsoft's proprietary DLLs out of our build output
         and therefore out of the published package — this is the redistribution guard. At runtime
         BcToolsLocator finds them in the user's own toolchain and registers an assembly resolver. -->
    <PropertyGroup>
        <BcToolsPath>$(NuGetPackageRoot)microsoft.dynamics.businesscentral.development.tools/$(BcDevToolsVersion)/tools/$(BcToolsTfm)/any/</BcToolsPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Microsoft.Dynamics.Nav.CodeAnalysis">
            <HintPath>$(BcToolsPath)Microsoft.Dynamics.Nav.CodeAnalysis.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Microsoft.Dynamics.Nav.CodeAnalysis.Workspaces">
            <HintPath>$(BcToolsPath)Microsoft.Dynamics.Nav.CodeAnalysis.Workspaces.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Microsoft.Dynamics.Nav.Analyzers.Common">
            <HintPath>$(BcToolsPath)Microsoft.Dynamics.Nav.Analyzers.Common.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
