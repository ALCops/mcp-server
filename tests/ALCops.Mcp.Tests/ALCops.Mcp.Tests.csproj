<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>Latest</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <BcDevToolsVersion Condition="'$(BcDevToolsVersion)'==''">18.0.41.39415</BcDevToolsVersion>
        <BcToolsTfm Condition="'$(BcToolsTfm)'==''">net10.0</BcToolsTfm>

        <!-- See the same suppression in src: 18.x ships ModelContextProtocol.Core 1.0.0 beside the
             referenced DLLs, which MSBuild's dependency walk flags against our 0.9.0-preview.2. -->
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Test-only. The server no longer bundles analyzers (issue #10) — it resolves them from the
             project's own al.codeAnalyzers config. The fixtures need *some* analyzer with real code
             fixes to exercise that path, and ALCops' own cops are what the fixtures are written
             against. IsPackable=false, so nothing here reaches a shipped artifact. -->
        <PackageReference Include="ALCops.Analyzers" Version="1.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ALCops.Mcp/ALCops.Mcp.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageDownload Include="Microsoft.Dynamics.BusinessCentral.Development.Tools" Version="[$(BcDevToolsVersion)]" />
    </ItemGroup>

    <PropertyGroup>
        <BcToolsPath>$(NuGetPackageRoot)microsoft.dynamics.businesscentral.development.tools/$(BcDevToolsVersion)/tools/$(BcToolsTfm)/any/</BcToolsPath>
    </PropertyGroup>

    <!-- Unlike src, tests need the BC DevTools DLLs *in the output directory*: the CI compatibility
         matrix hot-swaps these three files in the prebuilt test binary to run the same tests against
         every supported SDK version. Private=true is what puts them there. -->
    <ItemGroup>
        <Reference Include="Microsoft.Dynamics.Nav.CodeAnalysis">
            <HintPath>$(BcToolsPath)Microsoft.Dynamics.Nav.CodeAnalysis.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Microsoft.Dynamics.Nav.CodeAnalysis.Workspaces">
            <HintPath>$(BcToolsPath)Microsoft.Dynamics.Nav.CodeAnalysis.Workspaces.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Microsoft.Dynamics.Nav.Analyzers.Common">
            <HintPath>$(BcToolsPath)Microsoft.Dynamics.Nav.Analyzers.Common.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <!-- The BC DevTools folder holds almcp itself, which the test output folder does not (only the
         three Private=true DLLs land there). AlMcpProxyTests needs the real almcp, so surface the
         restore path to run time. -->
    <ItemGroup>
        <AssemblyMetadata Include="BcToolsPath" Value="$(BcToolsPath)" />
    </ItemGroup>

    <!-- Copy test fixture files to output -->
    <ItemGroup>
        <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures" />
    </ItemGroup>
</Project>
